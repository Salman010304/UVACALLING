        </div>
        
        <div id="tab-admissions" class="tab-content hidden flex-1 overflow-y-auto p-4 lg:p-6 w-full h-full flex-col items-center justify-center text-center pb-24">
            <div class="w-20 h-20 bg-blue-50 dark:bg-blue-900/20 rounded-full flex items-center justify-center mb-6 text-blue-500 dark:text-blue-400 shadow-soft">
                <i class="ph-fill ph-graduation-cap text-4xl"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-800 dark:text-white mb-2">Admissions Board</h2>
            <p class="text-slate-500 dark:text-slate-400 max-w-sm mb-6 text-xs md:text-sm">Manage confirmed admissions, fee receipts, and enrolled batches.</p>
        </div>

        <div id="tab-reports" class="tab-content hidden flex-1 overflow-y-auto p-4 lg:p-6 w-full h-full flex-col items-center justify-center text-center pb-24">
            <div class="w-20 h-20 bg-purple-50 dark:bg-purple-900/20 rounded-full flex items-center justify-center mb-6 text-purple-500 dark:text-purple-400 shadow-soft">
                <i class="ph-fill ph-file-text text-4xl"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-800 dark:text-white mb-2">Advanced Reports</h2>
            <p class="text-slate-500 dark:text-slate-400 max-w-sm mb-6 text-xs md:text-sm">Generate daily, weekly, and monthly lead reports.</p>
        </div>
        
        <div id="tab-analytics" class="tab-content hidden flex-1 overflow-y-auto p-4 lg:p-6 w-full h-full flex-col items-center justify-center text-center pb-24">
            <div class="w-20 h-20 bg-brand-50 dark:bg-brand-900/20 rounded-full flex items-center justify-center mb-6 text-brand-500 dark:text-brand-400 shadow-soft">
                <i class="ph-fill ph-chart-bar text-4xl"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-800 dark:text-white mb-2">Analytics Dashboard</h2>
            <p class="text-slate-500 dark:text-slate-400 max-w-sm mb-6 text-xs md:text-sm">Visualize course popularity, conversion rates, and revenue metrics.</p>
        </div>
        
        <div id="tab-settings" class="tab-content hidden flex-1 overflow-y-auto p-4 lg:p-6 w-full h-full flex-col items-center justify-center text-center pb-24">
            <div class="w-20 h-20 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mb-6 text-slate-500 dark:text-slate-400 shadow-soft">
                <i class="ph-fill ph-gear text-4xl"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-800 dark:text-white mb-2">System Settings</h2>
            <p class="text-slate-500 dark:text-slate-400 max-w-sm mb-6 text-xs md:text-sm">Configure custom fields, tags, and agent access controls.</p>
        </div>

    </main>

    <!-- App-Like Smartphone Bottom Navigation Tab Bar (thumbs-reach menu) -->
    <div class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/90 dark:bg-slate-900/90 border-t border-slate-200 dark:border-slate-850 backdrop-blur-lg flex justify-around items-center py-2.5 shadow-xl pb-safe">
        <button onclick="switchTab('dashboard', 'Overview'); document.getElementById('segmentBtnForm').click();" class="flex flex-col items-center gap-1 text-brand-600 dark:text-brand-400 transition-colors">
            <i class="ph-fill ph-squares-four text-xl"></i>
            <span class="text-[9px] font-bold">Dashboard</span>
        </button>
        <button onclick="switchTab('customers', 'Customer Database')" class="flex flex-col items-center gap-1 text-slate-400 hover:text-brand-500 transition-colors">
            <i class="ph ph-users text-xl"></i>
            <span class="text-[9px] font-semibold">Customers</span>
        </button>
        <button onclick="switchTab('followups', 'Follow Ups')" class="flex flex-col items-center gap-1 text-slate-400 hover:text-brand-500 transition-colors">
            <i class="ph ph-calendar-check text-xl"></i>
            <span class="text-[9px] font-semibold">Followups</span>
        </button>
        <button onclick="switchTab('admissions', 'Admissions Board')" class="flex flex-col items-center gap-1 text-slate-400 hover:text-brand-500 transition-colors">
            <i class="ph ph-graduation-cap text-xl"></i>
            <span class="text-[9px] font-semibold">Admissions</span>
        </button>
        <button onclick="toggleMobileMenu()" class="flex flex-col items-center gap-1 text-slate-400 hover:text-brand-500 transition-colors">
            <i class="ph ph-list text-xl"></i>
            <span class="text-[9px] font-semibold">Menu</span>
        </button>
    </div>
</div>

<!-- Complete Agent Profile Modal -->
<div id="agentProfileModal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-md z-[1000] hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 p-6 md:p-8 rounded-3xl w-full max-w-lg shadow-2xl border border-slate-100 dark:border-slate-700 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-brand-400 to-blue-500"></div>
        <div class="text-center mb-6">
            <div class="w-14 h-14 bg-brand-50 dark:bg-brand-900/30 rounded-full flex items-center justify-center mx-auto mb-3 text-brand-500">
                <i class="ph-fill ph-identification-badge text-2xl"></i>
            </div>
            <h3 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-white mb-1">Complete Your Profile</h3>
            <p class="text-slate-500 dark:text-slate-400 text-xs md:text-sm">Please set up your agent profile to access the CRM.</p>
        </div>
        
        <form id="agentProfileForm" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div class="input-group col-span-2">
                    <input type="text" id="profSetupFullName" required placeholder=" " class="dark:bg-slate-900/50">
                    <label>Full Legal Name *</label>
                </div>
                <div class="input-group">
                    <input type="text" id="profSetupDisplayName" required placeholder=" " class="dark:bg-slate-900/50">
                    <label>Display Name *</label>
                </div>
                <div class="input-group">
                    <input type="tel" id="profSetupMobile" required placeholder=" " class="dark:bg-slate-900/50">
                    <label>Mobile Number *</label>
                </div>
                <div class="input-group">
                    <select id="profSetupRole" required class="dark:bg-slate-900/50 appearance-none font-medium text-slate-700 dark:text-slate-200">
                        <option value="Counsellor">Counsellor</option>
                        <option value="Telecaller">Telecaller</option>
                        <option value="Manager">Manager</option>
                        <option value="Admin">Admin</option>
                    </select>
                    <label>Role *</label>
                    <i class="ph ph-caret-down absolute right-4 top-4 text-slate-400 pointer-events-none"></i>
                </div>
                <div class="input-group">
                    <select id="profSetupBranch" required class="dark:bg-slate-900/50 appearance-none font-medium text-slate-700 dark:text-slate-200">
                        <option value="Mehsana">Mehsana</option>
                    </select>
                    <label>Branch *</label>
                    <i class="ph ph-caret-down absolute right-4 top-4 text-slate-400 pointer-events-none"></i>
                </div>
                <div class="input-group col-span-2">
                    <input type="text" id="profSetupEmpId" placeholder=" " class="dark:bg-slate-900/50">
                    <label>Employee ID (Optional)</label>
                </div>
            </div>
            
            <button type="submit" id="profSetupBtn" class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-3.5 mt-4 rounded-xl shadow-md transition-all active:scale-[0.98] flex justify-center items-center gap-2">
                <i class="ph-fill ph-floppy-disk text-lg"></i> <span id="profSetupBtnText">Save Profile & Continue</span>
            </button>
        </form>
    </div>
</div>

<!-- Modal -->
<div id="customModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[1000] hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 p-8 rounded-3xl w-full max-w-sm text-center shadow-2xl border border-slate-100 dark:border-slate-700">
        <div class="w-16 h-16 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center mx-auto mb-4 text-blue-500">
            <i class="ph-fill ph-info text-3xl"></i>
        </div>
        <h3 id="modalTitle" class="text-xl font-bold mb-2 text-slate-800 dark:text-white">Notice</h3>
        <p id="modalMessage" class="text-slate-500 dark:text-slate-400 text-sm mb-8 leading-relaxed"></p>
        <button id="modalOkBtn" class="w-full py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl shadow-md transition-all active:scale-[0.98]">Got it, thanks!</button>
    </div>
</div>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, doc, setDoc, getDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
        apiKey: "AIzaSyD3ADa0VRM7lEMOJTwfK9JsDuZCPfgFafQ",
        authDomain: "uvacalling.firebaseapp.com",
        projectId: "uvacalling",
        storageBucket: "uvacalling.firebasestorage.app",
        messagingSenderId: "334125392697",
        appId: "1:334125392697:web:0fa25d2c80a91132d57ee8",
        measurementId: "G-X591KCY73X"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);
    const appId = typeof __app_id !== 'undefined' ? __app_id : 'uva-crm-app'; 

    let currentAgent = null;

    const CONFIG = { SCRIPT_URL: "https://script.google.com/macros/s/AKfycbwhc3Mz5tS4fDGfG1IE1rmPCqypIWbzQUTV2J-TthLMxfRfSR6NiksGPy9k5ZQ-PgIrPA/exec" };

    const scripts = {
        "interested_ai": "🌟 *Udaan Vibrant Academy* 🌟\n\nનમસ્તે,\nઆપણી વાતચીત મુજબ, જોબ અને કરિયર ગ્રોથ માટે અમારો પ્રેક્ટિકલ *AI Mastery Program* બેસ્ટ છે.\n\n{brochure_text}\n{custom_note}\n\nઆભાર,\n- {caller_name}\n\n📍 *સરનામું:* બાબીવાડા પરા રોડ, તળાવ પાસે, પીલાજી ગંજ, મહેસાણા, ગુજરાત 384001\n🗺️ *મેપ લિંક:* https://maps.app.goo.gl/HaJCT921VBbnnFgZ9?g_st=awb\n📞 *સંપર્ક:* 9408097177, 88660 77173",
        "interested_tally": "🌟 *Udaan Vibrant Academy* 🌟\n\nનમસ્તે,\nઆપણી વાતચીત મુજબ, *Complete Accountant Course* ની માહિતી આ રહી.\n\n{brochure_text}\n{custom_note}\n\nઆભાર,\n- {caller_name}\n\n📍 *સરનામું:* બાબીવાડા પરા રોડ, તળાવ પાસે, પીલાજી ગંજ, મહેસાણા, ગુજરાત 384001\n🗺️ *મેપ લિંક:* https://maps.app.goo.gl/HaJCT921VBbnnFgZ9?g_st=awb\n📞 *સંપર્ક:* 9408097177, 88660 77173",
        "interested_design": "🌟 *Udaan Vibrant Academy* 🌟\n\nનમસ્તે,\nઆપણી વાતચીત મુજબ, *DTP & Designing Course* ની માહિતી અહી છે.\n\n{brochure_text}\n{custom_note}\n\nઆભાર,\n- {caller_name}\n\n📍 *સરનામું:* બાબીવાડા પરા રોડ, તળાવ પાસે, પીલાજી ગંજ, મહેસાણા, ગુજરાત 384001\n🗺️ *મેપ લિંક:* https://maps.app.goo.gl/HaJCT921VBbnnFgZ9?g_st=awb\n📞 *સંપર્ક:* 9408097177, 88660 77173",
        "busy": "🌟 *Udaan Vibrant Academy* 🌟\n\nનમસ્તે,\nતમે થોડા વ્યસ્ત હતા એટલે આ શોર્ટ મેસેજ મોકલું છું. અમે જોબ અને કરિયર માટે AI, એકાઉન્ટિંગ અને ડિઝાઇનિંગની પ્રેક્ટિકલ ટ્રેનિંગ આપીએ છીએ.\n\n{brochure_text}\n\nઆભાર,\n- {caller_name}\n\n📍 *સરનામું:* બાબીવાડા પરા રોડ, તળાવ પાસે, પીલાજી ગંજ, મહેસાણા, ગુજરાત 384001\n🗺️ *મેપ લિંક:* https://maps.app.goo.gl/HaJCT921VBbnnFgZ9?g_st=awb\n📞 *સંપર્ક:* 9408097177, 88660 77173",
        "callback": "🌟 *Udaan Vibrant Academy* 🌟\n\nનમસ્તે,\nજેમ આપણે વાત થઈ, હું તમને આ બેઝિક માહિતી મોકલી રહ્યો છું. આપણે નક્કી કરેલા સમયે ફરીથી વાત કરીશું.\n\n{custom_note}\n\nઆભાર,\n- {caller_name}\n\n📍 *સરનામું:* બાબીવાડા પરા રોડ, તળાવ પાસે, પીલાજી ગંજ, મહેસાણા, ગુજરાત 384001\n🗺️ *મેપ લિંક:* https://maps.app.goo.gl/HaJCT921VBbnnFgZ9?g_st=awb\n📞 *સંપર્ક:* 9408097177, 88660 77173",
        "admission": "🌟 *Udaan Vibrant Academy* 🌟\n\nનમસ્તે,\nUdaan માં એડમિશન લેવા બદલ ખૂબ ખૂબ અભિનંદન! અમે તમારા ઉજ્જવળ ભવિષ્યની કામના કરીએ છીએ.\n\n{custom_note}\n\nઆભાર,\n- {caller_name}"
    };

    const setupUI = () => {
        const themeToggle = document.getElementById('themeToggle');
        themeToggle.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
        });
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        setInterval(() => {
            const now = new Date();
            document.getElementById('currentTime').innerText = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            document.getElementById('currentDate').innerText = now.toLocaleDateString([], {weekday: 'short', month: 'short', day: 'numeric'});
        }, 1000);

        document.addEventListener('click', (e) => {
            const dropdown = document.getElementById('profileDropdownMenu');
            const trigger = dropdown?.previousElementSibling;
            if (dropdown && dropdown.classList.contains('dropdown-active') && !dropdown.contains(e.target) && !trigger.contains(e.target)) {
                dropdown.classList.remove('dropdown-active');
            }
        });
    };
    setupUI();

    window.toggleMobileDashboardSegment = (segment) => {
        const formContainer = document.getElementById('mobileDashboardFormContainer');
        const previewContainer = document.getElementById('mobileDashboardPreviewContainer');
        const btnForm = document.getElementById('segmentBtnForm');
        const btnPreview = document.getElementById('segmentBtnPreview');

        if(segment === 'form') {
            formContainer.classList.remove('hidden');
            previewContainer.classList.add('hidden');
            previewContainer.classList.remove('block');
            
            btnForm.classList.add('bg-white', 'dark:bg-slate-700', 'shadow-sm', 'text-slate-800', 'dark:text-white');
            btnForm.classList.remove('text-slate-500', 'dark:text-slate-400');
            btnPreview.classList.remove('bg-white', 'dark:bg-slate-700', 'shadow-sm', 'text-slate-800', 'dark:text-white');
            btnPreview.classList.add('text-slate-500', 'dark:text-slate-400');
        } else {
            formContainer.classList.add('hidden');
            previewContainer.classList.remove('hidden');
            previewContainer.classList.add('block');
            
            btnPreview.classList.add('bg-white', 'dark:bg-slate-700', 'shadow-sm', 'text-slate-800', 'dark:text-white');
            btnPreview.classList.remove('text-slate-500', 'dark:text-slate-400');
            btnForm.classList.remove('bg-white', 'dark:bg-slate-700', 'shadow-sm', 'text-slate-800', 'dark:text-white');
            btnForm.classList.add('text-slate-500', 'dark:text-slate-400');
        }
    };

    window.toggleProfileDropdown = (e) => {
        e.stopPropagation();
        const dropdown = document.getElementById('profileDropdownMenu');
        dropdown.classList.toggle('dropdown-active');
    };

    window.openEditProfile = () => {
        if(currentAgent) {
            document.getElementById("profSetupFullName").value = currentAgent.fullName || "";
            document.getElementById("profSetupDisplayName").value = currentAgent.displayName || "";
            document.getElementById("profSetupMobile").value = currentAgent.mobile || "";
            document.getElementById("profSetupRole").value = currentAgent.role || "Counsellor";
            document.getElementById("profSetupBranch").value = currentAgent.branch || "Mehsana";
            document.getElementById("profSetupEmpId").value = currentAgent.employeeId || "";
        }
        document.getElementById("agentProfileModal").classList.remove('hidden');
        document.getElementById("agentProfileModal").classList.add('flex');
        document.getElementById("profileDropdownMenu").classList.remove('dropdown-active');
    };

    const updateGreeting = (name) => {
        const hour = new Date().getHours();
        let greeting = 'Good Evening';
        if (hour < 12) greeting = 'Good Morning';
        else if (hour < 18) greeting = 'Good Afternoon';
        document.getElementById("welcomeGreeting").innerHTML = `${greeting} ${name} 👋`;
    };

    window.customToast = (msg) => {
        const toast = document.getElementById('toastNotification');
        document.getElementById('toastMessage').innerText = msg;
        toast.classList.remove('translate-y-[-150%]', 'opacity-0');
        setTimeout(() => toast.classList.add('translate-y-[-150%]', 'opacity-0'), 3000);
    };

    window.showAlert = (msg) => {
        document.getElementById('modalMessage').innerText = msg;
        const modal = document.getElementById('customModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        
        document.getElementById('modalOkBtn').onclick = () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        };
    };

    const loadAgentProfile = async (user) => {
        const cachedProfile = localStorage.getItem(`uvaAgentProfile_${user.uid}`);
        if (cachedProfile) {
            currentAgent = JSON.parse(cachedProfile);
            updateAgentUI(currentAgent);
        }

        try {
            const agentRef = doc(db, 'artifacts', appId, 'public', 'data', 'agents', user.uid);
            const agentSnap = await getDoc(agentRef);
            
            if (agentSnap.exists()) {
                currentAgent = agentSnap.data();
                await setDoc(agentRef, { lastLogin: new Date().toISOString() }, { merge: true });
                localStorage.setItem(`uvaAgentProfile_${user.uid}`, JSON.stringify(currentAgent));
                updateAgentUI(currentAgent);
                initializeExtendedCRM(); 
            } else {
                document.getElementById('agentProfileModal').classList.remove('hidden');
                document.getElementById('agentProfileModal').classList.add('flex');
            }
        } catch (error) {
            console.error("Error loading profile:", error);
            if(!currentAgent) {
                document.getElementById('agentProfileModal').classList.remove('hidden');
                document.getElementById('agentProfileModal').classList.add('flex');
            }
        }
    };

    const updateAgentUI = (agent) => {
        const avatarUrl = agent.photoUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(agent.displayName)}&background=22c55e&color=fff&bold=true`;
        
        document.getElementById("displayAgentName").innerText = agent.displayName;
        document.getElementById("displayAgentRole").innerText = agent.role;
        document.getElementById("dropdownEmail").innerText = agent.email;
        document.getElementById("agentAvatar").src = avatarUrl;
        
        document.getElementById("callerName").value = agent.displayName;
        
        updateGreeting(agent.displayName);
    };

    document.getElementById('agentProfileForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const user = auth.currentUser;
        if (!user) return;

        const btn = document.getElementById("profSetupBtn");
        const btnText = document.getElementById("profSetupBtnText");
        btn.disabled = true;
        btnText.innerText = "Saving Profile...";

        const profileData = {
            uid: user.uid,
            fullName: document.getElementById("profSetupFullName").value,
            displayName: document.getElementById("profSetupDisplayName").value,
            mobile: document.getElementById("profSetupMobile").value,
            role: document.getElementById("profSetupRole").value,
            branch: document.getElementById("profSetupBranch").value,
            employeeId: document.getElementById("profSetupEmpId").value,
            email: user.email,
            photoUrl: "", 
            createdDate: currentAgent?.createdDate || new Date().toISOString(),
            lastLogin: new Date().toISOString()
        };

        try {
            const agentRef = doc(db, 'artifacts', appId, 'public', 'data', 'agents', user.uid);
            await setDoc(agentRef, profileData);
            
            currentAgent = profileData;
            localStorage.setItem(`uvaAgentProfile_${user.uid}`, JSON.stringify(currentAgent));
            
            document.getElementById('agentProfileModal').classList.add('hidden');
            document.getElementById('agentProfileModal').classList.remove('flex');
            
            updateAgentUI(currentAgent);
            customToast("Profile saved successfully!");
            initializeExtendedCRM();
        } catch (error) {
            console.error(error);
            showAlert("Error saving profile. Please check permissions.");
        } finally {
            btn.disabled = false;
            btnText.innerText = "Save Profile & Continue";
        }
    });

    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        }
      } catch (error) {
        console.error("Custom token sign in failed", error);
      }
    };
    initAuth();

    onAuthStateChanged(auth, (user) => {
        if (user) {
            document.getElementById('loginView').classList.add('hidden');
            document.getElementById('appView').classList.remove('hidden');
            
            loadAgentProfile(user).then(() => {
                loadHistory();
                updatePreview();
            });
        } else {
            currentAgent = null;
            document.getElementById('appView').classList.add('hidden');
            document.getElementById('loginView').classList.remove('hidden');
            document.getElementById('agentProfileModal').classList.add('hidden');
        }
    });

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('loginEmail').value;
        const pass = document.getElementById('loginPassword').value;
        const btnText = document.getElementById('loginBtnText');
        
        btnText.innerText = "Authenticating...";
        try {
            await signInWithEmailAndPassword(auth, email, pass);
        } catch (err) {
            btnText.innerText = "Secure Login";
            showAlert("Login failed: " + err.message);
        }
    });

    window.logout = () => signOut(auth);

    window.saveLead = async (data) => {
        const formData = new URLSearchParams();
        for (const key in data) formData.append(key, data[key]);
        
        if(currentAgent) {
            formData.append('agentName', currentAgent.displayName);
            formData.append('agentEmail', currentAgent.email);
            formData.append('agentUid', currentAgent.uid);
        }
        
        try {
            await fetch(CONFIG.SCRIPT_URL, { method: 'POST', mode: 'no-cors', body: formData });
            return true;
        } catch { return false; }
    };

    window.generateMessage = () => {
        const caller = currentAgent ? currentAgent.displayName : (document.getElementById("callerName").value || "Agent");
        const customerName = document.getElementById("customerName").value.trim();
        const mood = document.getElementById("customerMood").value;
        const note = document.getElementById("customNote").value;
        const brochure = document.getElementById("brochureLink").value;
        let finalMessage = scripts[mood].replace("{caller_name}", caller);
        if (customerName) finalMessage = finalMessage.replace("નમસ્તે,", `નમસ્તે ${customerName},`);
        finalMessage = finalMessage.replace("{custom_note}", note ? `📌 નોંધ: ${note}` : "").replace("{brochure_text}", brochure ? `📄 *વધુ માહિતી:* ${brochure}` : "");
        return finalMessage.replace(/\n\n\n/g, "\n\n");
    };

    window.updatePreview = () => {
        const customerName = document.getElementById("customerName").value.trim();
        document.getElementById("waContactName").innerText = customerName || "Customer Name";
        
        let msg = window.generateMessage();
        const timeHTML = `<span class="inline-block w-16"></span><div class="text-[10px] text-slate-500/80 dark:text-white/60 absolute bottom-1 right-2 flex items-center gap-1"><span>${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span><i class="ph-fill ph-check-fat text-blue-500"></i></div>`;
        document.getElementById("messagePreview").innerHTML = msg + timeHTML;
    };

    /* 
       Optimized `sendWhatsApp` function: 
       Opened instantly on synchronous call to completely bypass all smartphone popup-blocker restrictions. 
       The background CRM mapping and save scripts run concurrently.
    */
    window.sendWhatsApp = () => {
        const number = document.getElementById("customerNumber").value;
        if(number.length < 10) return showAlert("Please enter a valid 10-digit number.");
        
        const btn = document.getElementById("sendBtn");
        const originalContent = btn.innerHTML;
        btn.disabled = true; 
        btn.innerHTML = `<i class="ph-fill ph-spinner-gap animate-spin text-xl"></i> Syncing...`;
        
        // Synchronous immediate redirection ensures Chrome/Safari on iOS and Android never block the tab!
        const waUrl = `https://wa.me/91${number}?text=${encodeURIComponent(window.generateMessage())}`;
        window.open(waUrl, '_blank');
        
        // Launch asynchronous network logs in background without slowing down navigation
        const leadData = {
            caller: currentAgent ? currentAgent.displayName : document.getElementById("callerName").value,
            customerName: document.getElementById("customerName").value,
            phone: number,
            status: document.getElementById("customerMood").value
        };
        
        window.saveLead(leadData).then(() => {
            saveToExtendedCRMModule(number);
            const moodSelect = document.getElementById("customerMood");
            saveToHistory(number, moodSelect.options[moodSelect.selectedIndex].text);
            clearFormUI();
            customToast("Lead successfully created and mapped!");
        }).catch(() => {
            customToast("Saved locally. Network sync pending.");
        }).finally(() => {
            btn.disabled = false; 
            btn.innerHTML = originalContent;
        });
    };

    window.saveToHistory = (num, mood) => {
        let history = JSON.parse(localStorage.getItem("udaanHistory")) || [];
        const agentNameStr = currentAgent ? currentAgent.displayName : 'Unknown';
        history.unshift({ time: new Date().toLocaleTimeString(), number: num, mood: mood, agent: agentNameStr });
        if(history.length > 15) history.pop();
        localStorage.setItem("udaanHistory", JSON.stringify(history));
        loadHistory();
    };

    window.loadHistory = () => {
        let container = document.getElementById("historyBody");
        let history = JSON.parse(localStorage.getItem("udaanHistory")) || [];
        
        if(currentAgent) {
            history = history.filter(h => h.agent === currentAgent.displayName);
        }
        
        if(history.length === 0) {
            container.innerHTML = `<div class="p-4 text-center text-slate-500 text-sm">No recent activity found.</div>`;
            return;
        }

        container.innerHTML = history.map(item => `
            <div class="bg-white dark:bg-slate-800 p-3 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center gap-4 transition hover:-translate-y-0.5 mb-2">
                <div class="h-9 w-9 rounded-full bg-brand-50 dark:bg-brand-900/30 flex items-center justify-center border border-brand-100 dark:border-brand-800 shrink-0 text-brand-500">
                    <i class="ph-fill ph-user text-base"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex justify-between items-start mb-0.5">
                        <h4 class="text-sm font-bold text-slate-800 dark:text-slate-100 truncate">${item.number}</h4>
                        <span class="text-[9px] font-semibold text-slate-400 bg-slate-100 dark:bg-slate-900 px-1.5 py-0.5 rounded">${item.time}</span>
                    </div>
                    <div class="flex items-center justify-between mt-1">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[9px] font-bold tracking-wide bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
                            ${item.mood}
                        </span>
                    </div>
                </div>
            </div>`).join('');
    };

    window.clearHistory = () => { 
        if(confirm("Are you sure you want to clear your recent history?")) {
            let history = JSON.parse(localStorage.getItem("udaanHistory")) || [];
            if(currentAgent) {
                history = history.filter(h => h.agent !== currentAgent.displayName);
                localStorage.setItem("udaanHistory", JSON.stringify(history));
            } else {
                localStorage.removeItem("udaanHistory"); 
            }
            loadHistory(); 
            customToast("History cleared.");
        }
    };

    window.switchTab = (tabId, title, element = null) => {
        if (element) {
            document.querySelectorAll('.sidebar-link').forEach(el => {
                el.classList.remove('bg-brand-50', 'text-brand-600', 'dark:bg-brand-900/20', 'dark:text-brand-400');
                el.classList.add('text-slate-600', 'dark:text-slate-400');
            });
            element.classList.remove('text-slate-600', 'dark:text-slate-400');
            element.classList.add('bg-brand-50', 'text-brand-600', 'dark:bg-brand-900/20', 'dark:text-brand-400');
        }

        document.getElementById('currentTabTitle').innerText = title || 'Overview';

        document.querySelectorAll('.tab-content').forEach(el => {
            el.classList.add('hidden');
            el.classList.remove('lg:flex', 'flex');
        });
        
        const target = document.getElementById(`tab-${tabId}`);
        if(target) {
            target.classList.remove('hidden');
            if(tabId === 'dashboard') target.classList.add('lg:flex');
            else target.classList.add('flex');
        }

        // Close sidebar if on mobile screens
        const sidebar = document.getElementById('mainSidebar');
        if(sidebar && !sidebar.classList.contains('-translate-x-full')) {
            toggleMobileMenu();
        }
    };

    window.toggleMobileMenu = () => {
        const sidebar = document.getElementById('mainSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        
        if (sidebar.classList.contains('-translate-x-full')) {
            backdrop.classList.remove('hidden');
            setTimeout(() => backdrop.classList.remove('opacity-0'), 10);
            sidebar.classList.remove('-translate-x-full');
        } else {
            backdrop.classList.add('opacity-0');
            sidebar.classList.add('-translate-x-full');
            setTimeout(() => backdrop.classList.add('hidden'), 300);
        }
    };

    window.clearFormUI = () => {
        document.getElementById("customerName").value = "";
        document.getElementById("customerNumber").value = "";
        document.getElementById("dummyCity").value = "";
        document.getElementById("dummyEdu").value = "";
        document.getElementById("brochureLink").value = "";
        document.getElementById("customNote").value = "";
        document.getElementById("followUpDate").value = "";
        document.querySelectorAll('.custom-tag-checkbox').forEach(cb => cb.checked = false);
        document.getElementById("customerMood").selectedIndex = 0;
        updatePreview();
    };

    window.copyMsgUI = () => {
        navigator.clipboard.writeText(window.generateMessage());
        customToast("Message copied to clipboard!");
    };

    window.callCustomerUI = () => {
        const num = document.getElementById("customerNumber").value;
        if(num.length >= 10) window.open('tel:' + num);
        else showAlert("Please enter a valid phone number to call.");
    };


    let extendedCRM = { customers: [], timeline: {}, tasks: {} };
    let currentProfileId = null;

    const initializeExtendedCRM = () => {
        const savedData = localStorage.getItem("uvaExtendedCRM");
        if(savedData) {
            extendedCRM = JSON.parse(savedData);
        } else {
            extendedCRM = { customers: [], timeline: {}, tasks: {} };
        }
        renderCustomersList();
        updateDashboardStats();
    };

    window.saveToExtendedCRMModule = (phoneNum) => {
        const cid = "ID_" + Date.now();
        const nameInput = document.getElementById("customerName").value.trim();
        const moodSelect = document.getElementById("customerMood");
        const agentNameStr = currentAgent ? currentAgent.displayName : "Unknown Agent";
        
        let checkedTags = Array.from(document.querySelectorAll('.custom-tag-checkbox:checked')).map(cb => cb.value);

        const newCustomer = {
            id: cid,
            name: nameInput || "Unknown Lead",
            phone: phoneNum,
            course: moodSelect.options[moodSelect.selectedIndex].text.replace('રસ છે - ', '').replace('કોર્સ', '').trim(),
            status: moodSelect.value, 
            city: document.getElementById("dummyCity").value || "Not Specified",
            edu: document.getElementById("dummyEdu").value || "Not Specified",
            source: document.getElementById("leadSource").value,
            tags: checkedTags,
            followup: document.getElementById("followUpDate").value,
            assignedAgent: agentNameStr,
            created: new Date().toISOString(),
            updated: new Date().toISOString()
        };

        extendedCRM.customers.unshift(newCustomer);
        
        const now = new Date();
        extendedCRM.timeline[cid] = [
            { id: Date.now(), type: 'create', title: `Added by ${agentNameStr}`, desc: 'Added via New Lead Form', date: now.toLocaleDateString(), time: now.toLocaleTimeString(), agent: agentNameStr },
            { id: Date.now()+1, type: 'whatsapp', title: `WhatsApp Sent by ${agentNameStr}`, desc: 'Initial template message sent.', date: now.toLocaleDateString(), time: now.toLocaleTimeString(), agent: agentNameStr }
        ];

        extendedCRM.tasks[cid] = [
            { id: 1, text: "Send Brochure & Details", done: false },
            { id: 2, text: "Follow up call in 2 days", done: false },
            { id: 3, text: "Invite for office visit/demo", done: false }
        ];

        localStorage.setItem("uvaExtendedCRM", JSON.stringify(extendedCRM));
        renderCustomersList();
        updateDashboardStats();
    };

    const updateDashboardStats = () => {
        if(!currentAgent) return;
        const myName = currentAgent.displayName;
        const myCustomers = extendedCRM.customers.filter(c => c.assignedAgent === myName);

        document.getElementById('statTodayLeads').innerText = myCustomers.length; 
        document.getElementById('statAdmissions').innerText = myCustomers.filter(c => c.status === 'admission').length;
        document.getElementById('statFollowups').innerText = myCustomers.filter(c => c.followup).length;
        document.getElementById('sidebarFollowupBadge').innerText = myCustomers.filter(c => c.followup).length || "0";
        
        let history = JSON.parse(localStorage.getItem("udaanHistory")) || [];
        let myHistory = history.filter(h => h.agent === myName);
        document.getElementById('statWhatsApp').innerText = myHistory.length;
    };

    const renderCustomersList = () => {
        const grid = document.getElementById("customersGrid");
        if(!currentAgent) return;
        
        const myName = currentAgent.displayName;
        const myCustomers = extendedCRM.customers.filter(c => c.assignedAgent === myName);

        if(myCustomers.length === 0) {
            grid.innerHTML = `<div class="col-span-full text-center py-20 text-slate-400">
                <i class="ph-fill ph-users text-5xl mb-3 opacity-50"></i>
                <h3 class="text-lg font-bold text-slate-700 dark:text-slate-300">No Customers Yet</h3>
                <p class="text-sm">Create a new lead to see it appear here in your database.</p>
            </div>`;
            return;
        }

        grid.innerHTML = myCustomers.map(c => {
            let statusColor = "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400";
            if(c.status.includes('interested')) statusColor = "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 border border-green-200 dark:border-green-800";
            else if(c.status === 'busy') statusColor = "bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400 border border-yellow-200 dark:border-yellow-800";
            else if(c.status === 'callback') statusColor = "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400 border border-orange-200 dark:border-orange-800";
            else if(c.status === 'admission') statusColor = "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 border border-blue-200 dark:border-blue-800";

            return `
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-750 p-4 md:p-5 hover:shadow-md transition-shadow relative group">
                <div class="flex justify-between items-start mb-4">
                    <div class="flex gap-3 items-center min-w-0">
                        <img src="https://ui-avatars.com/api/?name=${encodeURIComponent(c.name)}&background=random" class="w-10 h-10 md:w-12 md:h-12 rounded-full shadow-sm">
                        <div class="min-w-0">
                            <h3 class="font-bold text-slate-800 dark:text-white text-base leading-tight truncate w-24 md:w-40">${c.name}</h3>
                            <span class="text-[11px] font-semibold text-slate-500">${c.phone}</span>
                        </div>
                    </div>
                    <span class="px-2 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider ${statusColor} shrink-0">${c.status.replace('interested_', 'Int. ')}</span>
                </div>
                
                <div class="space-y-2 text-xs md:text-sm text-slate-600 dark:text-slate-400 mb-5">
                    <div class="flex items-center gap-2"><i class="ph ph-briefcase text-base shrink-0"></i> <span class="truncate">${c.course}</span></div>
                    <div class="flex justify-between">
                        <span class="flex items-center gap-2"><i class="ph ph-map-pin text-base"></i> ${c.city}</span>
                        <span class="flex items-center gap-2"><i class="ph ph-user text-base"></i> ${c.assignedAgent || 'Agent'}</span>
                    </div>
                </div>
                
                <button onclick="window.openCustomerProfile('${c.id}')" class="w-full bg-slate-50 hover:bg-slate-100 dark:bg-slate-900/50 dark:hover:bg-slate-700 text-brand-600 dark:text-brand-400 font-bold py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 transition flex items-center justify-center gap-2 text-xs md:text-sm">
                    <i class="ph ph-user-circle"></i> Open Profile
                </button>
            </div>
            `;
        }).join('');
    };

    window.openCustomerProfile = (id) => {
        const customer = extendedCRM.customers.find(c => c.id === id);
        if(!customer) return;
        currentProfileId = id;

        document.getElementById("profName").innerText = customer.name;
        document.getElementById("profPhone").innerText = customer.phone;
        document.getElementById("profCity").innerText = customer.city;
        document.getElementById("profCourse").innerText = customer.course;
        document.getElementById("profSource").innerText = customer.source;
        document.getElementById("profEdu").innerText = customer.edu;
        document.getElementById("profCreated").innerText = new Date(customer.created).toLocaleString();
        document.getElementById("profAgent").innerText = customer.assignedAgent || "Unknown";
        document.getElementById("profAvatar").src = `https://ui-avatars.com/api/?name=${encodeURIComponent(customer.name)}&background=random&size=128`;
        
        document.getElementById("profileDirectWaBtn").onclick = () => {
            window.open(`https://wa.me/91${customer.phone}`, '_blank');
        };

        if(customer.tags && customer.tags.length > 0) {
            document.getElementById("profTagsList").innerHTML = customer.tags.map(t => `<span class="bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-300 text-[10px] font-bold px-2 py-0.5 rounded border border-slate-200 dark:border-slate-700">${t}</span>`).join('');
        } else {
            document.getElementById("profTagsList").innerHTML = '';
        }

        renderProfileTimeline(id);
        renderProfileTasks(id);
        renderJourney(customer.status);

        switchTab('profile', 'Customer Profile');
    };

    const renderJourney = (status) => {
        const steps = [
            { key: 'created', label: 'Lead Created' },
            { key: 'contacted', label: 'Contacted' },
            { key: 'interested', label: 'Interested' },
            { key: 'visit', label: 'Office Visit' },
            { key: 'admission', label: 'Admission Done' }
        ];

        let currentIndex = 1; 
        if(status.includes('interested')) currentIndex = 2;
        if(status === 'admission') currentIndex = 4;

        const html = steps.map((s, i) => {
            let colors = "bg-slate-100 text-slate-400 dark:bg-slate-800 dark:text-slate-500 border border-slate-200 dark:border-slate-700";
            if(i < currentIndex) colors = "bg-brand-500 text-white border-brand-500 shadow-[0_0_10px_rgba(34,197,94,0.3)]";
            else if(i === currentIndex) colors = "bg-brand-100 text-brand-700 dark:bg-brand-900/40 dark:text-brand-400 border border-brand-300 dark:border-brand-700 animate-pulse";
            
            let arrow = i < steps.length - 1 ? `<i class="ph ph-caret-right text-slate-300 dark:text-slate-600"></i>` : '';
            return `<div class="px-3 py-1.5 rounded-full whitespace-nowrap transition-all duration-500 ${colors}">${s.label}</div> ${arrow}`;
        }).join('');

        document.getElementById("profJourneyTracker").innerHTML = html;
    };

    const renderProfileTimeline = (id) => {
        const tEvents = extendedCRM.timeline[id] || [];
        if(tEvents.length === 0) {
            document.getElementById("profTimelineList").innerHTML = '<div class="text-sm text-slate-400 p-4">No activities logged yet.</div>';
            return;
        }

        document.getElementById("profTimelineList").innerHTML = `
            <div class="timeline-line"></div>
            ${tEvents.slice().reverse().map(ev => {
                let iconClass = 'ph-info';
                let iconBg = 'bg-blue-500 text-white';
                if(ev.type === 'note') { iconClass = 'ph-chat-text'; iconBg = 'bg-purple-500 text-white'; }
                if(ev.type === 'whatsapp') { iconClass = 'ph-whatsapp-logo'; iconBg = 'bg-green-500 text-white'; }
                
                return `
                <div class="relative pl-8 pb-4">
                    <div class="absolute left-[-2px] top-1 w-6 h-6 rounded-full ${iconBg} flex items-center justify-center border-4 border-white dark:border-slate-800 z-10 shadow-sm"><i class="ph-fill ${iconClass} text-[10px]"></i></div>
                    <div class="bg-white dark:bg-slate-800 p-3 rounded-xl shadow-sm border border-slate-100 dark:border-slate-700">
                        <div class="flex justify-between items-start mb-1">
                            <span class="font-bold text-sm text-slate-800 dark:text-slate-200">${ev.title}</span>
                            <span class="text-[10px] text-slate-400">${ev.date} ${ev.time}</span>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-400">${ev.desc}</p>
                        <div class="text-[9px] font-semibold text-slate-400 mt-2 flex items-center gap-1"><i class="ph-fill ph-user-circle"></i> By ${ev.agent}</div>
                    </div>
                </div>`;
            }).join('')}
        `;
    };

    window.addNoteToProfile = () => {
        const input = document.getElementById("newNoteInput");
        const text = input.value.trim();
        if(!text || !currentProfileId) return;

        const agentNameStr = currentAgent ? currentAgent.displayName : "Unknown Agent";
        const now = new Date();
        
        extendedCRM.timeline[currentProfileId].push({
            id: Date.now(), 
            type: 'note', 
            title: `Note added by ${agentNameStr}`, 
            desc: text, 
            date: now.toLocaleDateString(), 
            time: now.toLocaleTimeString(), 
            agent: agentNameStr
        });
        
        localStorage.setItem("uvaExtendedCRM", JSON.stringify(extendedCRM));
        input.value = "";
        renderProfileTimeline(currentProfileId);
        customToast("Note saved to timeline!");
    };

    const renderProfileTasks = (id) => {
        const tasks = extendedCRM.tasks[id] || [];
        const container = document.getElementById("profTasksList");
        
        if(tasks.length === 0) { container.innerHTML = '<div class="text-xs text-slate-400">No pending tasks.</div>'; return; }
        
        container.innerHTML = tasks.map(t => `
            <div class="flex items-center gap-3 p-2 hover:bg-slate-50 dark:hover:bg-slate-900/50 rounded-lg transition">
                <input type="checkbox" id="task_${t.id}" class="task-checkbox w-4 h-4 text-brand-500 rounded border-slate-300 cursor-pointer" ${t.done ? 'checked' : ''} onchange="window.toggleTask('${id}', ${t.id}, this.checked)">
                <label for="task_${t.id}" class="text-sm font-medium text-slate-700 dark:text-slate-300 cursor-pointer flex-1 transition-colors">${t.text}</label>
            </div>
        `).join('');
    };

    window.toggleTask = (cid, taskId, isDone) => {
        const task = extendedCRM.tasks[cid].find(t => t.id === taskId);
        if(task) {
            task.done = isDone;
            localStorage.setItem("uvaExtendedCRM", JSON.stringify(extendedCRM));
            
            if(isDone) {
                const agentNameStr = currentAgent ? currentAgent.displayName : "Unknown Agent";
                const now = new Date();
                extendedCRM.timeline[cid].push({
                    id: Date.now(), 
                    type: 'task', 
                    title: `Task completed by ${agentNameStr}`, 
                    desc: `Checked off: ${task.text}`, 
                    date: now.toLocaleDateString(), 
                    time: now.toLocaleTimeString(), 
                    agent: agentNameStr
                });
                renderProfileTimeline(cid);
            }
        }
    };

</script>
</body>
</html>
