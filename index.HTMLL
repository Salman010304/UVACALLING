        <div id="tab-profile" class="tab-content hidden flex-1 overflow-y-auto p-4 lg:p-6 w-full relative pb-24">
            <button onclick="switchTab('customers', 'Customer Database')" class="absolute top-4 right-4 p-2.5 bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-800 dark:hover:text-white rounded-full transition z-10 shadow-sm">
                <i class="ph ph-x font-bold text-lg"></i>
            </button>
            
            <div class="max-w-6xl mx-auto space-y-6 mt-8 lg:mt-0">
                <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-soft border border-slate-100 dark:border-slate-700 p-5 md:p-6 flex flex-col md:flex-row gap-6 items-center md:items-start relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-blue-500 via-brand-500 to-purple-500"></div>
                    
                    <div class="relative">
                        <img src="" id="profAvatar" class="w-20 h-20 md:w-24 md:h-24 rounded-full border-4 border-white dark:border-slate-800 shadow-md">
                        <div id="profStatusIcon" class="absolute bottom-0 right-0 w-6 h-6 md:w-8 md:h-8 rounded-full bg-brand-500 border-2 border-white dark:border-slate-800 flex items-center justify-center text-white text-xs md:text-sm shadow-sm">
                            <i class="ph-fill ph-check-circle"></i>
                        </div>
                    </div>
                    
                    <div class="flex-1 text-center md:text-left space-y-2 w-full">
                        <div class="flex flex-col md:flex-row md:items-center gap-2">
