<!DOCTYPE html>
<html lang="gu" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>UVACALLING - Student Lead Management CRM</title>
    
    <!-- PWA Meta Tags for App Installation -->
    <meta name="theme-color" content="#22c55e">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="UVACRM">
    <link rel="manifest" id="manifest-link">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#f0fdf4', 100: '#dcfce7', 500: '#22c55e', 600: '#16a34a', 900: '#14532d' },
                        crm: { 50: '#f8fafc', 800: '#1e293b', 900: '#0f172a' }
                    },
                    boxShadow: {
                        'soft': '0 4px 20px -2px rgba(0, 0, 0, 0.05)',
                        'glow': '0 0 15px rgba(34, 197, 94, 0.3)'
                    }
                }
            }
        }
    </script>
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            -webkit-tap-highlight-color: transparent; 
            overscroll-behavior-y: contain; 
        }
        .whatsapp-bg { 
            background-color: #e5ddd5; 
            background-image: url('https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png');
            background-repeat: repeat;
            background-size: 300px;
        }
        .dark .whatsapp-bg {
            background-color: #0b141a;
            background-blend-mode: multiply;
        }
        
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
        
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.3); }
        .dark .glass { background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.05); }

        .input-group { position: relative; }
        /* Mobile-focused inputs set to 16px to completely eliminate mobile Safari's auto-zooming glitch */
        .input-group input, .input-group select, .input-group textarea {
            width: 100%; padding: 1.25rem 1rem 0.5rem; background-color: transparent;
            border: 1px solid #e2e8f0; border-radius: 0.75rem; transition: all 0.2s;
            color: inherit; font-size: 16px;
        }
        .dark .input-group input, .dark .input-group select, .dark .input-group textarea { border-color: #334155; }
        .input-group input:focus, .input-group select:focus, .input-group textarea:focus {
            outline: none; border-color: #22c55e; box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }
        .input-group label {
            position: absolute; left: 1rem; top: 0.85rem; font-size: 0.875rem;
            color: #64748b; pointer-events: none; transition: all 0.2s; transform-origin: left top;
        }
        .input-group input:focus ~ label, .input-group input:not(:placeholder-shown) ~ label,
        .input-group select:focus ~ label, .input-group select:not([value=""]) ~ label,
        .input-group textarea:focus ~ label, .input-group textarea:not(:placeholder-shown) ~ label {
            top: 0.25rem; font-size: 0.65rem; color: #22c55e; font-weight: 600;
        }
        
        /* Timeline styling */
        .timeline-container { position: relative; padding-left: 24px; }
        .timeline-line { position: absolute; left: 7px; top: 4px; bottom: 0; width: 2px; background: #e2e8f0; }
        .dark .timeline-line { background: #334155; }
        .timeline-dot { position: absolute; left: 0; top: 4px; width: 16px; height: 16px; border-radius: 50%; background: #22c55e; border: 3px solid #fff; z-index: 10; }
        .dark .timeline-dot { border-color: #1e293b; }
        
        /* Checkbox styling */
        .task-checkbox:checked + label { text-decoration: line-through; color: #94a3b8; }
        
        /* Dropdown transition */
        .dropdown-enter { opacity: 0; transform: scale(0.95) translateY(-10px); pointer-events: none; }
        .dropdown-active { opacity: 1; transform: scale(1) translateY(0); pointer-events: auto; transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1); }
        
        /* Safe Area Padding for Modern Smart Phones */
        .pb-safe {
            padding-bottom: env(safe-area-inset-bottom, 12px);
        }
    </style>
</head>
<body class="bg-crm-50 dark:bg-crm-900 text-slate-800 dark:text-slate-200 antialiased h-screen overflow-hidden transition-colors duration-300">

<!-- PWA & Service Worker Initialization -->
<script>
    const manifest = {
        "name": "UVACRM - Student Lead Management",
        "short_name": "UVACRM",
        "start_url": ".",
        "display": "standalone",
        "background_color": "#f8fafc",
        "theme_color": "#22c55e",
        "icons": [{
            "src": "https://ui-avatars.com/api/?name=UVA&background=22c55e&color=fff&size=512",
            "sizes": "512x512",
            "type": "image/png"
        }]
    };
    const manifestBlob = new Blob([JSON.stringify(manifest)], {type: 'application/json'});
    document.getElementById('manifest-link').href = URL.createObjectURL(manifestBlob);
    
    if ('serviceWorker' in navigator) {
        const swCode = `
            self.addEventListener('install', (e) => self.skipWaiting());
            self.addEventListener('activate', (e) => self.clients.claim());
            self.addEventListener('fetch', (e) => {});
        `;
        const swBlob = new Blob([swCode], {type: 'application/javascript'});
        navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(err => console.log('SW registration failed:', err));
    }
</script>

<!-- Toast Notification -->
<div id="toastNotification" class="fixed top-5 right-5 z-[9999] flex items-center gap-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-2xl rounded-xl p-4 transform translate-y-[-150%] opacity-0 transition-all duration-300 ease-out">
    <div class="h-8 w-8 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center">
        <i class="ph-fill ph-check-circle text-xl"></i>
    </div>
    <div class="flex flex-col pr-4">
        <span class="text-sm font-bold text-slate-800 dark:text-white">Notification</span>
        <span id="toastMessage" class="text-xs text-slate-500 dark:text-slate-400">Action completed successfully.</span>
    </div>
</div>

<!-- Login View -->
<div id="loginView" class="fixed inset-0 z-50 flex items-center justify-center bg-cover bg-center p-4 transition-opacity duration-500" style="background-image: url('https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&q=80&w=2000');">
    <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm"></div>
    
    <div class="relative z-10 flex flex-col md:flex-row w-full max-w-5xl rounded-3xl overflow-hidden shadow-2xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border border-white/20">
        <div class="md:w-5/12 bg-gradient-to-br from-brand-500 to-brand-900 p-8 md:p-10 text-white flex flex-col justify-between relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-full bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
            <div class="relative z-10">
                <div class="flex items-center gap-2 mb-10 md:mb-12">
                    <div class="bg-white p-2 rounded-xl text-brand-600"><i class="ph-fill ph-student text-2xl"></i></div>
                    <span class="text-xl font-bold tracking-wider">UVACRM</span>
                </div>
                <h1 class="text-4xl md:text-5xl font-extrabold mb-4 md:mb-6 leading-tight tracking-tight">Lead<br>Management.</h1>
                <p class="text-brand-50 text-base md:text-lg mb-8 opacity-90">The Premium Student Management CRM built exclusively for Udaan Vibrant Academy.</p>
                
                <div class="space-y-4 text-sm font-medium opacity-90">
                    <div class="flex items-center gap-3"><i class="ph-fill ph-check-circle text-brand-100 text-xl"></i> Complete Student Journey</div>
                    <div class="flex items-center gap-3"><i class="ph-fill ph-lightning text-brand-100 text-xl"></i> 1-Click WhatsApp Sync</div>
                    <div class="flex items-center gap-3"><i class="ph-fill ph-shield-check text-brand-100 text-xl"></i> Secure Agent Profiles</div>
                </div>
            </div>
        </div>
        
        <div class="md:w-7/12 p-6 md:p-14 flex flex-col justify-center">
            <div class="max-w-md w-full mx-auto">
                <div class="text-center mb-8 md:mb-10">
                    <h2 class="text-2xl md:text-3xl font-extrabold text-slate-800 dark:text-white mb-2">Agent Portal</h2>
                    <p class="text-slate-500 dark:text-slate-400">Sign in to access your CRM dashboard</p>
                </div>
                
                <form id="loginForm" class="space-y-5">
                    <div class="input-group">
                        <input type="email" id="loginEmail" placeholder=" " required class="dark:bg-slate-800">
                        <label>Email Address</label>
                        <i class="ph ph-envelope-simple absolute right-4 top-4 text-slate-400 text-xl"></i>
                    </div>
                    <div class="input-group">
                        <input type="password" id="loginPassword" placeholder=" " required class="dark:bg-slate-800">
                        <label>Password</label>
                        <i class="ph ph-lock-key absolute right-4 top-4 text-slate-400 text-xl"></i>
                    </div>
                    
                    <button type="submit" id="loginBtn" class="w-full bg-brand-600 hover:bg-brand-500 text-white font-bold py-3.5 rounded-xl shadow-[0_8px_20px_-6px_rgba(22,163,74,0.5)] transition-all active:scale-[0.98] flex justify-center items-center gap-2 mt-4">
                        <i class="ph ph-sign-in text-lg"></i> <span id="loginBtnText">Secure Login</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- App View -->
<div id="appView" class="hidden h-screen w-full flex bg-crm-50 dark:bg-crm-900 overflow-hidden relative">
    
    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebarBackdrop" onclick="toggleMobileMenu()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"></div>

    <!-- Left Sidebar (Drawer on Mobile, hidden bottom half on tiny layouts) -->
    <aside id="mainSidebar" class="w-64 flex-shrink-0 bg-white dark:bg-slate-800 border-r border-slate-200 dark:border-slate-700 flex flex-col fixed md:relative h-full z-50 shadow-soft transition-transform duration-300 -translate-x-full md:translate-x-0">
        <div class="h-16 flex items-center px-6 border-b border-slate-100 dark:border-slate-700 gap-3 justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-brand-100 text-brand-600 p-1.5 rounded-lg"><i class="ph-fill ph-student text-xl"></i></div>
                <span class="text-lg font-extrabold tracking-wide text-slate-800 dark:text-white">UVACRM</span>
            </div>
            <button onclick="toggleMobileMenu()" class="md:hidden text-slate-400 hover:text-slate-600 dark:hover:text-white text-xl"><i class="ph ph-x"></i></button>
        </div>
        
        <div class="p-4 flex-1 overflow-y-auto space-y-1">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 mt-4 px-3">Main Menu</div>
            <a href="#" onclick="switchTab('dashboard', 'Overview', this)" class="sidebar-link bg-brand-50 text-brand-600 dark:bg-brand-900/20 dark:text-brand-400 flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-colors">
                <i class="ph-fill ph-squares-four text-lg"></i> Dashboard
            </a>
            <a href="#" onclick="switchTab('dashboard', 'New Lead Entry', this)" class="sidebar-link text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-colors">
                <i class="ph ph-user-plus text-lg"></i> New Lead
            </a>
            <a href="#" onclick="switchTab('customers', 'Customer Database', this)" class="sidebar-link text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-colors">
                <i class="ph ph-users text-lg"></i> Customers
            </a>
            <a href="#" onclick="switchTab('followups', 'Follow Ups', this)" class="sidebar-link text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center justify-between px-3 py-2.5 rounded-xl font-medium transition-colors">
                <div class="flex items-center gap-3"><i class="ph ph-calendar-check text-lg"></i> Follow Ups</div>
                <span class="bg-orange-100 text-orange-600 dark:bg-orange-900/30 dark:text-orange-400 py-0.5 px-2 rounded-md text-xs font-bold" id="sidebarFollowupBadge">0</span>
            </a>
            <a href="#" onclick="switchTab('admissions', 'Admissions Board', this)" class="sidebar-link text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-colors">
                <i class="ph ph-graduation-cap text-lg"></i> Admissions
            </a>
            
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 mt-6 px-3">Analytics & Settings</div>
            <a href="#" onclick="switchTab('reports', 'Reports', this)" class="sidebar-link text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-colors">
                <i class="ph ph-file-text text-lg"></i> Reports
            </a>
            <a href="#" onclick="switchTab('analytics', 'Analytics', this)" class="sidebar-link text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-colors">
                <i class="ph ph-chart-bar text-lg"></i> Analytics
            </a>
            <a href="#" onclick="switchTab('settings', 'System Settings', this)" class="sidebar-link text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-colors">
                <i class="ph ph-gear text-lg"></i> Settings
            </a>
        </div>
        
        <div class="p-4 border-t border-slate-100 dark:border-slate-700">
            <button onclick="logout()" class="flex items-center gap-3 w-full px-3 py-2.5 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-xl font-medium transition-colors">
                <i class="ph ph-sign-out text-lg"></i> Logout
            </button>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden relative w-full pb-16 md:pb-0">
        <!-- Header -->
        <header class="h-16 glass z-10 flex items-center justify-between px-4 lg:px-8 shrink-0 shadow-sm border-b border-slate-200 dark:border-slate-700">
            <div class="flex items-center gap-4">
                <button onclick="toggleMobileMenu()" class="md:hidden text-slate-500 text-2xl hover:text-brand-600 transition"><i class="ph ph-list"></i></button>
                <div>
                    <h2 class="text-lg font-bold text-slate-800 dark:text-white leading-tight" id="currentTabTitle">Overview</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium" id="currentDate">Mon, Oct 24</p>
                </div>
            </div>
            
            <div class="hidden md:flex flex-1 max-w-md mx-8 relative">
                <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" placeholder="Search leads, phones, or courses..." class="w-full bg-slate-100 dark:bg-slate-800 border-none rounded-full py-2 pl-10 pr-4 text-sm focus:ring-2 focus:ring-brand-500 outline-none text-slate-700 dark:text-slate-200 transition-all">
            </div>

            <div class="flex items-center gap-3 sm:gap-5 relative">
                <div class="text-right hidden sm:block">
                    <div class="text-sm font-bold text-slate-800 dark:text-white" id="currentTime">10:24 AM</div>
                </div>
                <button id="themeToggle" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-white bg-slate-100 dark:bg-slate-800 rounded-full transition-all">
                    <i class="ph-fill ph-moon dark:hidden text-lg"></i>
                    <i class="ph-fill ph-sun hidden dark:block text-lg"></i>
                </button>
                
                <!-- Premium Profile Dropdown Trigger -->
                <div class="relative">
                    <div onclick="toggleProfileDropdown(event)" class="flex items-center gap-3 cursor-pointer p-1 pr-3 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-all border border-transparent hover:border-slate-200 dark:hover:border-slate-700">
                        <div class="relative">
                            <img src="https://ui-avatars.com/api/?name=Agent&background=22c55e&color=fff" id="agentAvatar" class="w-9 h-9 rounded-full border-2 border-white dark:border-slate-600 shadow-sm object-cover">
                            <!-- Online Status Dot -->
                            <div class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-green-500 border-2 border-white dark:border-slate-800 rounded-full"></div>
                        </div>
                        <div class="hidden sm:block leading-tight">
                            <div class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-1">
                                <span id="displayAgentName">Agent Name</span>
                                <i class="ph-fill ph-caret-down text-xs text-slate-400"></i>
                            </div>
                            <div class="text-[10px] font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-wide" id="displayAgentRole">Counsellor</div>
                        </div>
                    </div>

                    <!-- Profile Dropdown Menu -->
                    <div id="profileDropdownMenu" class="dropdown-enter absolute right-0 top-[110%] mt-1 w-56 bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-slate-100 dark:border-slate-700 overflow-hidden z-50">
                        <div class="p-4 border-b border-slate-100 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/20">
                            <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider mb-1">Signed in as</p>
                            <p class="text-sm font-bold text-slate-800 dark:text-white truncate" id="dropdownEmail">agent@udaan.com</p>
                        </div>
                        <div class="p-2 space-y-1">
                            <a href="#" class="flex items-center gap-3 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 rounded-xl transition-colors">
                                <i class="ph ph-user-circle text-lg text-slate-400"></i> My Profile
                            </a>
                            <a href="#" onclick="openEditProfile()" class="flex items-center gap-3 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 rounded-xl transition-colors">
                                <i class="ph ph-pencil-simple text-lg text-slate-400"></i> Edit Profile
                            </a>
                            <a href="#" class="flex items-center gap-3 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 rounded-xl transition-colors">
                                <i class="ph ph-gear text-lg text-slate-400"></i> Settings
                            </a>
                        </div>
                        <div class="p-2 border-t border-slate-100 dark:border-slate-700">
                            <a href="#" onclick="logout()" class="flex items-center gap-3 px-3 py-2 text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-xl transition-colors">
                                <i class="ph ph-sign-out text-lg"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- DASHBOARD & NEW LEAD TAB -->
        <div id="tab-dashboard" class="tab-content flex-1 overflow-y-auto p-4 lg:p-6 lg:flex lg:gap-6 w-full">
            
            <div class="flex-1 space-y-4 md:space-y-6 w-full">
                <!-- Mobile Segment Switcher Pill (Avoids screen overflow & infinite scroll on phones) -->
                <div class="lg:hidden flex bg-slate-100 dark:bg-slate-800 p-1 rounded-xl w-full">
                    <button onclick="toggleMobileDashboardSegment('form')" id="segmentBtnForm" class="flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-white dark:bg-slate-700 shadow-sm text-slate-800 dark:text-white">
                        <i class="ph ph-user-plus mr-1"></i> Lead Entry Form
                    </button>
                    <button onclick="toggleMobileDashboardSegment('preview')" id="segmentBtnPreview" class="flex-1 py-2 text-xs font-bold rounded-lg transition-all text-slate-500 dark:text-slate-400">
                        <i class="ph ph-chat-circle-dots mr-1"></i> Preview & History
                    </button>
                </div>

                <div class="flex justify-between items-center">
                    <h2 id="welcomeGreeting" class="text-xl md:text-3xl font-extrabold text-slate-800 dark:text-white leading-tight">Good Morning! 👋</h2>
                </div>
                
                <!-- Stats Row (Filters to Current Agent) -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
                    <div class="bg-white dark:bg-slate-800 p-3.5 md:p-4 rounded-2xl shadow-soft border border-slate-100 dark:border-slate-700 hover:-translate-y-1 transition-transform">
                        <div class="flex justify-between items-start mb-2">
                            <div class="bg-blue-100 text-blue-600 dark:bg-blue-900/40 p-2 rounded-xl"><i class="ph-fill ph-users text-lg md:text-xl"></i></div>
                        </div>
                        <h4 class="text-slate-500 dark:text-slate-400 text-[10px] md:text-xs font-semibold mb-1">Today's Leads</h4>
                        <div class="text-lg md:text-2xl font-extrabold text-slate-800 dark:text-white" id="statTodayLeads">0</div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 p-3.5 md:p-4 rounded-2xl shadow-soft border border-slate-100 dark:border-slate-700 hover:-translate-y-1 transition-transform">
                        <div class="flex justify-between items-start mb-2">
                            <div class="bg-green-100 text-green-600 dark:bg-green-900/40 p-2 rounded-xl"><i class="ph-fill ph-check-square-offset text-lg md:text-xl"></i></div>
                        </div>
                        <h4 class="text-slate-500 dark:text-slate-400 text-[10px] md:text-xs font-semibold mb-1">Admissions</h4>
                        <div class="text-lg md:text-2xl font-extrabold text-slate-800 dark:text-white" id="statAdmissions">0</div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 p-3.5 md:p-4 rounded-2xl shadow-soft border border-slate-100 dark:border-slate-700 hover:-translate-y-1 transition-transform">
                        <div class="flex justify-between items-start mb-2">
                            <div class="bg-orange-100 text-orange-600 dark:bg-orange-900/40 p-2 rounded-xl"><i class="ph-fill ph-clock-counter-clockwise text-lg md:text-xl"></i></div>
                        </div>
                        <h4 class="text-slate-500 dark:text-slate-400 text-[10px] md:text-xs font-semibold mb-1">Follow Ups</h4>
                        <div class="text-lg md:text-2xl font-extrabold text-slate-800 dark:text-white" id="statFollowups">0</div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 p-3.5 md:p-4 rounded-2xl shadow-soft border border-slate-100 dark:border-slate-700 hover:-translate-y-1 transition-transform">
                        <div class="flex justify-between items-start mb-2">
                            <div class="bg-brand-100 text-brand-600 dark:bg-brand-900/40 p-2 rounded-xl"><i class="ph-fill ph-whatsapp-logo text-lg md:text-xl"></i></div>
                        </div>
                        <h4 class="text-slate-500 dark:text-slate-400 text-[10px] md:text-xs font-semibold mb-1">WhatsApp Sent</h4>
                        <div class="text-lg md:text-2xl font-extrabold text-slate-800 dark:text-white" id="statWhatsApp">0</div>
                    </div>
                </div>

                <!-- LEAD ENTRY FORM -->
                <div id="mobileDashboardFormContainer" class="bg-white dark:bg-slate-800 rounded-3xl shadow-soft border border-slate-100 dark:border-slate-700 overflow-hidden relative">
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-400 to-blue-500"></div>
                    
                    <div class="p-4 md:p-8 flex flex-col md:flex-row md:items-center justify-between border-b border-slate-100 dark:border-slate-700 gap-2">
                        <div>
                            <h2 class="text-lg md:text-xl font-bold text-slate-800 dark:text-white flex items-center gap-2">
                                <i class="ph-fill ph-user-plus text-brand-500"></i> New Lead Entry
                            </h2>
                            <p class="text-xs md:text-sm text-slate-500 dark:text-slate-400">Log details and send instantly to WhatsApp.</p>
                        </div>
                        <button onclick="clearFormUI()" class="py-2 px-3 self-end md:self-auto text-xs text-slate-500 hover:text-slate-800 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl transition" title="Clear Form">
                            <i class="ph ph-eraser text-base mr-1 inline"></i> Clear Form
                        </button>
                    </div>

                    <!-- Hidden input preserved for backward compatibility -->
                    <input type="hidden" id="callerName" value="">
                    
                    <div class="p-4 md:p-8 space-y-5 md:space-y-8">
                        <div>
                            <h3 class="text-xs md:text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                                <i class="ph ph-identification-card text-slate-400 text-base"></i> Customer Information
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="input-group">
                                    <input type="text" id="customerName" oninput="updatePreview()" placeholder=" " class="dark:bg-slate-900/50">
                                    <label>Customer Name</label>
                                </div>
                                <div class="input-group">
                                    <input type="tel" id="customerNumber" oninput="updatePreview()" required placeholder=" " class="dark:bg-slate-900/50">
                                    <label>WhatsApp Number *</label>
                                </div>
                                <div class="input-group">
                                    <input type="text" id="dummyCity" placeholder=" " class="dark:bg-slate-900/50">
                                    <label>City (Optional)</label>
                                </div>
                                <div class="input-group">
                                    <input type="text" id="dummyEdu" placeholder=" " class="dark:bg-slate-900/50">
                                    <label>Education / Occupation</label>
                                </div>
                                <div class="input-group md:col-span-2">
                                    <select id="leadSource" class="dark:bg-slate-900/50 appearance-none font-medium text-slate-700 dark:text-slate-200">
                                        <option value="Instagram">Instagram</option>
                                        <option value="Facebook">Facebook</option>
                                        <option value="Google">Google</option>
                                        <option value="Website">Website</option>
                                        <option value="Cold Calling">Cold Calling</option>
                                        <option value="Reference">Reference</option>
                                        <option value="Walk In">Walk In</option>
                                        <option value="WhatsApp" selected>WhatsApp</option>
                                    </select>
                                    <label>Lead Source</label>
                                    <i class="ph ph-caret-down absolute right-4 top-4 text-slate-400 pointer-events-none"></i>
                                </div>
                                <div class="md:col-span-2 mt-1">
                                    <label class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Customer Tags</label>
                                    <div class="flex flex-wrap gap-2" id="tagContainer">
                                        <label class="cursor-pointer">
                                            <input type="checkbox" value="Hot Lead" class="peer hidden custom-tag-checkbox">
                                            <div class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-xs md:text-sm font-medium text-slate-600 dark:text-slate-400 peer-checked:bg-red-50 peer-checked:text-red-600 peer-checked:border-red-200 dark:peer-checked:bg-red-900/30 dark:peer-checked:text-red-400 dark:peer-checked:border-red-800 transition">🔥 Hot Lead</div>
                                        </label>
                                        <label class="cursor-pointer">
                                            <input type="checkbox" value="Warm Lead" class="peer hidden custom-tag-checkbox">
                                            <div class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-xs md:text-sm font-medium text-slate-600 dark:text-slate-400 peer-checked:bg-orange-50 peer-checked:text-orange-600 peer-checked:border-orange-200 dark:peer-checked:bg-orange-900/30 dark:peer-checked:text-orange-400 dark:peer-checked:border-orange-800 transition">☀️ Warm Lead</div>
                                        </label>
                                        <label class="cursor-pointer">
                                            <input type="checkbox" value="Job Seeker" class="peer hidden custom-tag-checkbox">
                                            <div class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-xs md:text-sm font-medium text-slate-600 dark:text-slate-400 peer-checked:bg-blue-50 peer-checked:text-blue-600 peer-checked:border-blue-200 dark:peer-checked:bg-blue-900/30 dark:peer-checked:text-blue-400 dark:peer-checked:border-blue-800 transition">💼 Job Seeker</div>
                                        </label>
                                        <label class="cursor-pointer">
                                            <input type="checkbox" value="College Student" class="peer hidden custom-tag-checkbox">
                                            <div class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-xs md:text-sm font-medium text-slate-600 dark:text-slate-400 peer-checked:bg-purple-50 peer-checked:text-purple-600 peer-checked:border-purple-200 dark:peer-checked:bg-purple-900/30 dark:peer-checked:text-purple-400 dark:peer-checked:border-purple-800 transition">🎓 College Student</div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-xs md:text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider mb-4 flex items-center gap-2 border-t border-slate-100 dark:border-slate-700 pt-6">
                                <i class="ph ph-briefcase text-slate-400 text-base"></i> Interest & Status
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="input-group">
                                    <select id="customerMood" onchange="updatePreview()" class="dark:bg-slate-900/50 appearance-none font-medium text-slate-700 dark:text-slate-200">
                                        <option value="interested_ai" class="text-slate-800">રસ છે - AI Mastery કોર્સ</option>
                                        <option value="interested_tally" class="text-slate-800">રસ છે - Tally Accountant કોર્સ</option>
                                        <option value="interested_design" class="text-slate-800">રસ છે - DTP & Design કોર્સ</option>
                                        <option value="busy" class="text-slate-800">અત્યારે વ્યસ્ત છે</option>
                                        <option value="callback" class="text-slate-800">પછીથી વાત કરશે</option>
                                        <option value="admission" class="text-slate-800">એડમિશન લીધું (Admission Done)</option>
                                    </select>
                                    <label>Customer Response (Mood)</label>
                                    <i class="ph ph-caret-down absolute right-4 top-4 text-slate-400 pointer-events-none"></i>
                                </div>
                                <div class="input-group">
                                    <input type="url" id="brochureLink" oninput="updatePreview()" placeholder=" " class="dark:bg-slate-900/50">
                                    <label>Brochure Link (Optional)</label>
                                </div>
                                <div class="input-group md:col-span-2">
                                    <input type="datetime-local" id="followUpDate" class="dark:bg-slate-900/50">
                                    <label>Next Follow Up Date/Time</label>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="input-group">
                                <textarea id="customNote" rows="2" oninput="updatePreview()" placeholder=" " class="dark:bg-slate-900/50 resize-none"></textarea>
                                <label>Custom Notes for Customer</label>
                            </div>
                        </div>

                        <div class="pt-2 flex flex-col sm:flex-row gap-3">
                            <button id="sendBtn" onclick="sendWhatsApp()" class="flex-1 bg-brand-500 hover:bg-brand-600 text-white font-bold py-3.5 px-6 rounded-xl shadow-[0_8px_20px_-6px_rgba(34,197,94,0.5)] transition-all active:scale-[0.98] flex justify-center items-center gap-2">
                                <i class="ph-fill ph-whatsapp-logo text-xl"></i> Create Lead & Sync WA
                            </button>
                            <div class="flex gap-2">
                                <button onclick="copyMsgUI()" class="flex-1 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-white font-bold py-3 px-4 rounded-xl transition-all flex justify-center items-center gap-2">
                                    <i class="ph ph-copy"></i> Copy Message
                                </button>
                                <button onclick="callCustomerUI()" class="flex-1 bg-blue-50 hover:bg-blue-100 dark:bg-blue-900/30 dark:hover:bg-blue-900/50 text-blue-600 dark:text-blue-400 font-bold py-3 px-4 rounded-xl transition-all flex justify-center items-center gap-2 border border-blue-200 dark:border-blue-800/50">
                                    <i class="ph-fill ph-phone-call"></i> Call Now
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column (Responsive: Collapsed under Form on phones unless segment toggled) -->
            <div id="mobileDashboardPreviewContainer" class="hidden lg:block w-full lg:w-[420px] shrink-0 mt-0 space-y-6">
                <!-- Live WhatsApp Preview -->
                <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-soft border border-slate-100 dark:border-slate-700 overflow-hidden flex flex-col h-[380px] md:h-[450px]">
                    <div class="bg-[#075e54] dark:bg-[#1f2c34] text-white p-3 flex items-center gap-3 shrink-0">
                        <i class="ph ph-arrow-left text-xl ml-1"></i>
                        <img src="https://ui-avatars.com/api/?name=Customer&background=cbd5e1&color=fff" class="w-10 h-10 rounded-full" id="waProfilePic">
                        <div class="flex-1 min-w-0">
                            <div class="font-bold truncate text-[15px]" id="waContactName">Customer Name</div>
                            <div class="text-[11px] text-white/80 font-normal">online</div>
                        </div>
                        <div class="flex gap-4 pr-2 hidden sm:flex">
                            <i class="ph-fill ph-video-camera text-xl"></i>
                            <i class="ph-fill ph-phone text-xl"></i>
                            <i class="ph ph-dots-three-vertical text-xl"></i>
                        </div>
                    </div>
                    <div class="whatsapp-bg flex-1 overflow-y-auto p-4 flex flex-col shadow-inner">
                        <div class="text-center mb-4">
                            <span class="bg-[#e1f3fb] dark:bg-[#182229] text-slate-600 dark:text-slate-400 text-xs py-1 px-3 rounded-lg shadow-sm border border-black/5 dark:border-white/5 uppercase font-medium">Today</span>
                        </div>
                        <div class="bg-[#dcf8c6] dark:bg-[#005c4b] p-3 rounded-xl rounded-tr-none text-sm text-[#111b21] dark:text-[#e9edef] shadow-sm whitespace-pre-wrap ml-auto max-w-[95%] sm:max-w-[85%] relative pb-6 leading-snug font-sans" id="messagePreview">
                            <!-- JS fills this -->
                        </div>
                    </div>
                    <div class="bg-[#f0f0f0] dark:bg-[#202c33] p-2 flex items-center gap-2 shrink-0">
                        <i class="ph ph-smiley text-slate-500 dark:text-slate-400 text-2xl mx-1"></i>
                        <div class="flex-1 bg-white dark:bg-[#2a3942] rounded-full px-4 py-2 text-xs text-slate-400 border-none truncate">Message</div>
                        <div class="w-10 h-10 rounded-full bg-[#00a884] flex items-center justify-center text-white shrink-0 ml-1">
                            <i class="ph-fill ph-microphone text-xl"></i>
                        </div>
                    </div>
                </div>

                <!-- History -->
                <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-soft border border-slate-100 dark:border-slate-700 flex flex-col max-h-[350px] md:max-h-[450px]">
                    <div class="p-4 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center shrink-0">
                        <h3 class="font-bold text-slate-800 dark:text-white flex items-center gap-2 text-sm">
                            <i class="ph-fill ph-clock-counter-clockwise text-blue-500 text-lg"></i> My Recent Activity
                        </h3>
                        <button onclick="clearHistory()" class="text-[11px] font-semibold text-red-500 hover:text-red-600 bg-red-50 hover:bg-red-100 dark:bg-red-900/20 dark:hover:bg-red-900/40 px-2.5 py-1.5 rounded-md transition-colors">
                            Clear
                        </button>
                    </div>
                    
                    <div class="p-3 overflow-y-auto flex-1 space-y-3 bg-slate-50/50 dark:bg-slate-900/20" id="historyBody">
                        <!-- History Cards injected here -->
                    </div>
                </div>
            </div>
        </div>

        <!-- CUSTOMERS TAB -->
        <div id="tab-customers" class="tab-content hidden flex-1 overflow-hidden flex flex-col w-full bg-crm-50 dark:bg-crm-900">
            <div class="p-4 lg:p-6 pb-2 flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 w-full sm:w-auto">
                    <select class="w-full sm:w-auto bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-medium rounded-xl px-4 py-2.5 outline-none focus:ring-2 focus:ring-brand-500 text-slate-700 dark:text-slate-200">
                        <option>My Leads & Customers</option>
                        <option>Only Admissions</option>
                        <option>Interested Leads</option>
                    </select>
                </div>
                <button onclick="switchTab('dashboard', 'New Lead Entry')" class="w-full sm:w-auto bg-brand-500 hover:bg-brand-600 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition-all shadow-md flex items-center justify-center gap-2">
                    <i class="ph ph-plus"></i> New Lead
