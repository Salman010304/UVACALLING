                            <div class="flex gap-2 justify-center flex-wrap" id="profTagsList"></div>
                        </div>
                        <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 text-xs md:text-sm text-slate-500 dark:text-slate-400 font-medium">
                            <span class="flex items-center gap-1"><i class="ph ph-phone text-base"></i> <span id="profPhone"></span></span>
                            <span class="flex items-center gap-1"><i class="ph ph-map-pin text-base"></i> <span id="profCity"></span></span>
                            <span class="flex items-center gap-1"><i class="ph ph-briefcase text-base"></i> <span id="profCourse"></span></span>
                        </div>
                    </div>
                    
                    <div class="flex gap-3 w-full md:w-auto justify-center">
                        <button id="profileDirectWaBtn" class="w-full md:w-auto bg-brand-100 hover:bg-brand-200 text-brand-700 dark:bg-brand-900/30 dark:hover:bg-brand-900/50 dark:text-brand-400 px-6 py-2.5 rounded-xl font-bold text-sm transition flex items-center justify-center gap-2">
                            <i class="ph-fill ph-whatsapp-logo text-lg"></i> Message
                        </button>
                    </div>
                </div>

                <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-soft border border-slate-100 dark:border-slate-700 p-4 overflow-hidden">
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Customer Journey</h4>
                    <div class="flex items-center overflow-x-auto text-xs font-semibold space-x-2 pb-2 w-full no-scrollbar" id="profJourneyTracker"></div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="space-y-6">
                        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-soft border border-slate-100 dark:border-slate-700 p-5">
                            <h3 class="font-bold text-slate-800 dark:text-white flex items-center gap-2 mb-4 border-b border-slate-100 dark:border-slate-700 pb-2">
                                <i class="ph-fill ph-identification-card text-blue-500"></i> Lead Details
                            </h3>
                            <div class="space-y-4 text-sm">
                                <div>
                                    <span class="block text-slate-400 text-[10px] font-semibold uppercase">Lead Source</span>
                                    <span class="font-medium text-slate-800 dark:text-slate-200" id="profSource"></span>
                                </div>
                                <div>
                                    <span class="block text-slate-400 text-[10px] font-semibold uppercase">Education / Occupation</span>
                                    <span class="font-medium text-slate-800 dark:text-slate-200" id="profEdu"></span>
                                </div>
                                <div>
                                    <span class="block text-slate-400 text-[10px] font-semibold uppercase">Assigned Counsellor</span>
                                    <span class="font-medium text-slate-800 dark:text-slate-200" id="profAgent">Agent Name</span>
                                </div>
                                <div>
                                    <span class="block text-slate-400 text-[10px] font-semibold uppercase">Created Date</span>
                                    <span class="font-medium text-slate-800 dark:text-slate-200" id="profCreated"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-1 space-y-6">
                        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-soft border border-slate-100 dark:border-slate-700 flex flex-col h-[380px] md:h-[450px]">
                            <div class="p-4 border-b border-slate-100 dark:border-slate-700">
                                <h3 class="font-bold text-slate-800 dark:text-white flex items-center gap-2 text-sm">
                                    <i class="ph-fill ph-clock-counter-clockwise text-purple-500"></i> Notes & Timeline
                                </h3>
                            </div>
                            <div class="flex-1 overflow-y-auto p-4 space-y-5 timeline-container bg-slate-50/50 dark:bg-slate-900/20" id="profTimelineList"></div>
                            <div class="p-3 bg-white dark:bg-slate-800 border-t border-slate-100 dark:border-slate-700">
                                <div class="flex gap-2">
                                    <input type="text" id="newNoteInput" placeholder="Add a note or update..." class="flex-1 bg-slate-100 dark:bg-slate-900 border-none rounded-xl px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-brand-500">
                                    <button onclick="addNoteToProfile()" class="bg-brand-500 hover:bg-brand-600 text-white p-3 rounded-xl shadow-sm transition"><i class="ph-fill ph-paper-plane-right"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-soft border border-slate-100 dark:border-slate-700 p-5">
                            <h3 class="font-bold text-slate-800 dark:text-white flex items-center gap-2 mb-4 border-b border-slate-100 dark:border-slate-700 pb-2">
                                <i class="ph-fill ph-check-square-offset text-green-500"></i> Task Management
